# Google OAuth
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Google API Key (for public APIs: Books, YouTube, Custom Search, etc.)
VITE_GOOGLE_API_KEY=

# Google Custom Search Engine ID (https://programmablesearchengine.google.com/)
VITE_GOOGLE_CUSTOM_SEARCH_CX=

# Pexels (optional, for backgrounds)
VITE_PEXELS_API_KEY=

# Supabase (for auth + cloud sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (for push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
