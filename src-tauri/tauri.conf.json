{
  "productName": "APHEKA",
  "version": "6.25.2",
  "identifier": "com.owa.studio",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APHEKA",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "resources": {
      "bin/yt-dlp-x86_64-pc-windows-msvc.exe": "bin/yt-dlp.exe",
      "bin/ffmpeg-x86_64-pc-windows-msvc.exe": "bin/ffmpeg.exe",
      "bin/ffprobe-x86_64-pc-windows-msvc.exe": "bin/ffprobe.exe",
      "resources/asr/": "asr/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "installer-template.nsi",
        "installMode": "both",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "Spanish"
        ],
        "customLanguageFiles": {
          "Spanish": "installer-assets/Spanish.nsh"
        },
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "2c58d5ce-7ade-517b-ae4c-6a57e15f39fd"
      }
    },
    "publisher": "owa",
    "copyright": "Hecho por Gewodev"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "notification": null
  }
}
