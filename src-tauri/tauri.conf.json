{
    "productName":  "West",
    "version":  "6.27.4",
    "identifier":  "com.owa.studio",
    "build":  {
                  "beforeDevCommand":  "pnpm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "West",
                                    "width":  1200,
                                    "height":  800,
                                    "resizable":  true,
                                    "maximized":  true,
                                    "fullscreen":  false,
                                    "decorations":  true,
                                    "transparent":  false,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "resources":  {
                                     "bin/yt-dlp-x86_64-pc-windows-msvc.exe":  "bin/yt-dlp.exe",
                                     "bin/ffmpeg-x86_64-pc-windows-msvc.exe":  "bin/ffmpeg.exe",
                                     "resources/asr/ONNX-LICENSE.txt":  "asr/ONNX-LICENSE.txt"
                                 },
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/icon.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "allowDowngrades":  false,
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "nsis":  {
                                                "template":  "installer-template.nsi",
                                                "installMode":  "both",
                                                "installerHooks":  "installer-hooks.nsh",
                                                "languages":  [
                                                                  "Spanish"
                                                              ],
                                                "customLanguageFiles":  {
                                                                            "Spanish":  "installer-assets/Spanish.nsh"
                                                                        },
                                                "headerImage":  "installer-assets/header.bmp",
                                                "sidebarImage":  "installer-assets/sidebar.bmp",
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico"
                                            },
                                   "wix":  {
                                               "upgradeCode":  "2c58d5ce-7ade-517b-ae4c-6a57e15f39fd"
                                           }
                               },
                   "publisher":  "owa",
                   "copyright":  "Hecho por Gewodev",
                   "createUpdaterArtifacts":  false
               },
    "plugins":  {
                    "shell":  {
                                  "open":  true
                              },
                    "fs":  {
                               "requireLiteralLeadingDot":  false
                           },
                    "notification":  null,
                    "updater":  {
                                    "active":  true,
                                    "dialog":  false,
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2ODc3Mzk0QTU3MTk3RjEKUldUeGwzR2xsSE9IaGdHMmNKZFJpbzM4TDdkQUM5bngrYjlhVkFrcTdqaGYraTlhUDluRWhRQzYK",
                                    "endpoints":  [
                                                      "https://github.com/AuthomiaAgency/Owa_Studio/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                },
    "mainBinaryName":  "West"
}