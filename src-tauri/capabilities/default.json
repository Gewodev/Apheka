{
  "identifier": "default",
  "description": "Default capabilities for OWA Studio",
  "windows": ["main", "floating-timer"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-kill"
  ]
}
