{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for OWA Studio",
  "windows": ["main", "floating-timer", "pdf-viewer"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-decorations",
    "core:window:allow-start-dragging",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "$APPCACHE/**" },
        { "path": "$APPCACHE" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA" },
        { "path": "$RESOURCE/**" },
        { "path": "$RESOURCE" },
        { "path": "$HOME/**" },
        { "path": "$HOME" },
        { "path": "C:/Users/USER/AppData/Local/com.owa.studio/**" },
        { "path": "C:/Users/USER/AppData/Local/com.owa.studio" }
      ]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$RESOURCE/**" }, { "path": "$RESOURCE" }, { "path": "$HOME/**" }, { "path": "$HOME" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio/**" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$HOME/**" }, { "path": "$HOME" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio/**" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$HOME/**" }, { "path": "$HOME" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio/**" }, { "path": "C:/Users/USER/AppData/Local/com.owa.studio" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$HOME/**" }, { "path": "$HOME" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$HOME/**" }, { "path": "$HOME" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPCACHE" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "$HOME/**" }, { "path": "$HOME" }]
    },
    "shell:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-permission-state",
    "notification:allow-register-action-types",
    "notification:allow-check-permissions"
  ]
}
